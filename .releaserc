{
  "branches": [
    "main",
    {
      "name": "alpha",
      "prerelease": true
    },
    {
      "name": "beta",
      "prerelease": true
    }
  ],
  "tagFormat": "${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "uv run .github/utils/update_version.py ${nextRelease.version} && uv lock && if [ \"${branch.name}\" = \"main\" ]; then for app in tests/example_app*/; do uv lock --project \"$app\" --upgrade-package splunk-soar-sdk; done; python3 .github/utils/changelog.py render --version ${nextRelease.version} --date \"$(date -u +%F)\" && git add -A -- .changes; fi",
        "verifyReleaseCmd": "echo \"${nextRelease.version}\" > release_version.txt",
        "generateNotesCmd": "python3 .github/utils/changelog.py notes --version ${nextRelease.version} | tee release_notes.txt"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "pyproject.toml",
          "uv.lock",
          "tests/example_app*/pyproject.toml",
          "tests/example_app*/uv.lock",
          "docs/changelog.rst",
          ".changes/**"
        ],
        "message": "chore(release): update version to ${nextRelease.version} [skip ci]"
      }
    ],
    "@semantic-release/github"
  ]
}

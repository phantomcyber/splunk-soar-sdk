  "components": {
    "schemas": {
      "CreateManualFindingRequest": {
        "type": "object",
        "description": "The request of the create manual finding api call.",
        "required": [
          "rule_title",
          "security_domain"
        ],
        "properties": {
          "rule_title": {
            "type": "string",
            "description": "The rule title for the manual finding.",
            "example": "24 hour risk threshold exceeded for user=evilsender@update.defenceonline.net"
          },
          "rule_description": {
            "type": "string",
            "description": "The rule description for the manual finding.",
            "example": "Risk Threshold Exceeded for an object over a 24 hour period"
          },
          "security_domain": {
            "type": "string",
            "description": "The security domain for the manual finding to be created.",
            "example": "threat"
          },
          "risk_object": {
            "type": "string",
            "description": "The risk object for the manual finding to be created.",
            "example": "bad_user@splunk.com"
          },
          "risk_object_type": {
            "type": "string",
            "description": "The risk object type for the manual finding to be created.",
            "example": "user"
          },
          "risk_score": {
            "type": "number",
            "description": "The risk score for the manual finding to be created.",
            "example": 100
          },
          "status": {
            "type": "string",
            "description": "The status id or status label of the manual finding to be created.",
            "example": "New"
          },
          "urgency": {
            "type": "string",
            "description": "The urgency id or urgency label of the manual finding to be created.",
            "example": "informational"
          },
          "owner": {
            "type": "string",
            "description": "The owner for the manual finding to be created.",
            "example": "splunk_user"
          },
          "disposition": {
            "type": "string",
            "description": "The disposition id or disposition label of the manual finding to be created.",
            "example": "disposition:6"
          },
          "drilldown_searches": {
            "type": "array",
            "description": "The drilldown searches for the manual finding to be created.",
            "items": {
              "$ref": "#/components/schemas/DrilldownSearch"
            },
            "example": [
              {
                "name": "drilldown_name",
                "search": "index=_internal",
                "earliest": "-1d@h",
                "latest": "$info_max_time$"
              }
            ]
          },
          "drilldown_dashboards": {
            "type": "array",
            "description": "The drilldown dashboards for the manual finding to be created.",
            "items": {
              "$ref": "#/components/schemas/DrilldownDashboard"
            },
            "example": [
              {
                "name": "dashboard_name",
                "dashboard": "my_dashboard",
                "tokens": [
                  "token1",
                  "token2"
                ]
              }
            ]
          },
          "annotations": {
            "type": "object",
            "description": "The annotations for the manual finding to be created.",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string",
                "example": "T1078"
              },
              "example": [
                "T1078",
                "T1537"
              ]
            },
            "example": {
              "mitre_attack": [
                "T1078",
                "T1537"
              ]
            }
          },
          "risk_event_count": {
            "type": "number",
            "description": "The risk event count for the manual finding to be created.",
            "example": 5
          },
          "all_risk_objects": {
            "type": "array",
            "description": "The risk objects for the manual finding to be created.",
            "items": {
              "type": "string",
              "example": "bad_user@splunk.com"
            },
            "example": [
              "bad_user@splunk.com",
              "bad_user2@splunk.com"
            ]
          },
          "source": {
            "type": "array",
            "description": "The sources for the manual finding to be created.",
            "items": {
              "type": "string",
              "example": "demo_identities"
            },
            "example": [
              "source_1",
              "source_2"
            ]
          },
          "exclude_map_fields": {
            "type": "array",
            "description": "The fields to exclude from the automatic 'orig_' prefix mapping. When writing data to the notable index, the backend will append 'orig_' prefix to certain fields. For fields specified in the `exclude_map_fields`, the backend will not append this prefix. To see which fields will automatically get the prefix, check the `mapfields` parameter in the definition of the notable alert action.",
            "items": {
              "type": "string",
              "example": "investigation_profiles"
            },
            "example": [
              "investigation_profiles",
              "recommended_actions"
            ]
          },
          "queue_id": {
            "type": "string",
            "description": "The queue id of the finding.",
            "example": "test-queue-triage"
          },
          "email": {
            "$ref": "#/components/schemas/PhishingEmailObject"
          },
          "run_threat_analysis": {
            "type": "boolean",
            "description": "Flag to submit the finding to Splunk Attack Analyzer (SAA) for threat analysis.",
            "example": true
          },
          "launch_automation": {
            "type": "boolean",
            "description": "Flag to dispatch the finding to SOAR for automation after SAA analysis completes (or immediately if run_threat_analysis is false).",
            "example": true
          },
          "automation_rule": {
            "type": "string",
            "description": "The name of the automation rule/playbook to execute in SOAR. Required if launch_automation is true.",
            "example": "phishing_playbook_auto"
          },
          "finding_source": {
            "type": "string",
            "description": "Identifies where the finding originated. Use this to categorize manual findings by their source system or intake method. If not provided, defaults to \"ES Notable Event\".",
            "example": "Threat - MS Graph Office 365"
          },
          "investigation_type": {
            "type": "string",
            "description": "The investigation type to assign to this finding. If not provided, the system default investigation type is used.",
            "example": "default"
          },
          "additional_fields": {
            "type": "array",
            "description": "A list of name/value pairs for additional fields to include in the finding. Field names must be from the event_attributes list configured in log_review.conf (e.g. src, dest, user). If the field list cannot be fetched, validation is skipped. Fields are merged into the payload before processing. If a name conflicts with a top-level field, the top-level value takes precedence.",
            "items": {
              "type": "object",
              "description": "A name and value pair describing an event field.",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The name of the field.",
                  "example": "src"
                },
                "value": {
                  "type": "string",
                  "description": "The value of the field.",
                  "example": "192.168.1.100"
                }
              },
              "example": {
                "name": "src",
                "value": "192.168.1.100"
              }
            },
            "example": [
              {
                "name": "src",
                "value": "192.168.1.100"
              },
              {
                "name": "dest",
                "value": "203.0.113.5"
              },
              {
                "name": "user",
                "value": "analyst_user"
              }
            ]
          }
        },
        "example": {

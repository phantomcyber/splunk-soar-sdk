          "drilldown_dashboards": [
            {
              "name": "My Dashboard",
              "dashboard": "my_dashboard",
              "tokens": [
                "token1",
                "token2"
              ]
            }
          ],
          "exclude_map_fields": [
            "investigation_profiles",
            "recommended_actions"
          ],
          "risk_event_count": 5,
          "annotations": {
            "mitre_attack": [
              "T1078",
              "T1537"
            ]
          },
          "all_risk_objects": [
            "bad_user@splunk.com",
            "bad_user2@splunk.com"
          ],
          "sources": [
            "source_1",
            "source_2"
          ],
          "queue_id": "test-queue-triage",
          "finding_source": "Threat - MS Graph Office 365",
          "email": {
            "headers": {
